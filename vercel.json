{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install --frozen-lockfile --prod=false && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/mesurado-dashboard run build",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "outputDirectory": "artifacts/mesurado-dashboard/dist/public",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/((?!api/|v1/).*)", "destination": "/index.html" }
  ]
}
