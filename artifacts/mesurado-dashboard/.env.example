# ─── Appwrite ─────────────────────────────────────────────────────────────────
APPWRITE_ENDPOINT=https://mediatechliberia.online/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=mesurado

# ─── AI Server ────────────────────────────────────────────────────────────────
MESURADO_CORE_URL=https://your-ai-inference-server.com
MESURADO_MASTER_TOKEN=your_shared_master_token

# ─── Session Security ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=your_very_long_random_session_secret_at_least_32_chars

# ─── Auto-populated by next.config.js (do not set manually) ──────────────────
# NEXT_PUBLIC_APPWRITE_ENDPOINT
# NEXT_PUBLIC_APPWRITE_PROJECT_ID
