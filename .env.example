# ─── REQUIRED SECRETS ──────────────────────────────────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values to Git.

# Appwrite server-side API key (Integrations → API Keys → Server key)
APPWRITE_API_KEY=your_appwrite_api_key_here

# Random secret used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=your_session_secret_here

# Master token that authenticates this gateway to the Mesurado AI inference engine
MESURADO_MASTER_TOKEN=your_master_token_here

# HTTPS URL of the Mesurado AI inference engine  ← MUST be HTTPS in production
# Example: https://ai.yourdomain.com
MESURADO_CORE_URL=https://your-inference-engine-here

# ─── OPTIONAL: EMAIL NOTIFICATIONS (leave blank to disable) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── PUBLIC CONFIG — fallbacks are baked in; override only if you customise ────
# These already have correct defaults and do NOT need to be set in Vercel
# unless you use a different Appwrite project or database.

# APPWRITE_ENDPOINT=https://mediatechliberia.online/v1
# APPWRITE_PROJECT_ID=mesurado01
# APPWRITE_DATABASE_ID=mesurado
# APPWRITE_STORAGE_BUCKET_ID=payment_screenshots
# MESURADO_DOMAIN=mesurado.mediatechliberia.online
# LOG_LEVEL=info
# MAX_CONCURRENT_GATEKEEPER=3
# RATE_LIMIT_FREE_PER_MINUTE=10
# RATE_LIMIT_PAID_PER_MINUTE=60
# ADMIN_EMAIL=

# ─── FRONTEND (Vite — also have built-in fallbacks) ───────────────────────────
# VITE_APPWRITE_ENDPOINT=https://mediatechliberia.online/v1
# VITE_APPWRITE_PROJECT_ID=mesurado01
